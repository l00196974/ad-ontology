# env.conf — 环境变量配置
# run_daily.sh 启动时自动加载此文件
# 复制此文件并填入真实的 API Key

# ============================================================
# 采集引擎 API Key
# ============================================================
# Exa.ai API Key（https://exa.ai 获取）
export EXA_API_KEY=""

# Tavily API Key（可选，仅 --engine tavily 时需要）
# export TAVILY_API_KEY=""

# ============================================================
# LLM API 配置（Pipeline tag/select/insight 阶段需要）
# ============================================================
# OpenAI 兼容 API 地址
export LLM_BASE_URL="https://ark.cn-beijing.volces.com/api/coding/v3"

# LLM API Key
export LLM_API_KEY=""

# 模型名称
export LLM_MODEL="ark-code-latest"
